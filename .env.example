# Copy this file to ".env" and fill in your details.

# Your Groq API key. Get one at https://console.groq.com/keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=inclusionai/ming-image-0.1-design-layer
# Base URL for the OpenAI-compatible Groq endpoint. Usually you don't need to change this.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Default model to use. Examples: llama-3.3-70b-versatile, llama-3.1-8b-instant,
# openai/gpt-oss-120b, qwen/qwen3-32b
GROQ_MODEL=llama-3.3-70b-versatile

# Default UI language: en, ur, es, fr
APP_LANGUAGE=en

# Default UI theme: dark, light
APP_THEME=dark
